<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <IsAotCompatible>true</IsAotCompatible>
    <IsPackable>true</IsPackable>
    <PackageId>TheSpectre.ApiEnvelope.AspNetCore</PackageId>
    <Description>ASP.NET Core integration for TheSpectre.ApiEnvelope: correlation ids, global exception handling and status-code enveloping. No package dependencies.</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TheSpectre.ApiEnvelope\TheSpectre.ApiEnvelope.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TheSpectre.ApiEnvelope.AspNetCore.Tests" />
    <InternalsVisibleTo Include="TheSpectre.ApiEnvelope.FluentValidation" />
  </ItemGroup>

</Project>
