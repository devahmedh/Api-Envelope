<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <PackageId>TheSpectre.ApiEnvelope.DataAnnotations</PackageId>
    <Description>DataAnnotations integration for TheSpectre.ApiEnvelope: turns model validation failures into stable error KEYS with structured params, identical to the FluentValidation integration.</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TheSpectre.ApiEnvelope.AspNetCore\TheSpectre.ApiEnvelope.AspNetCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TheSpectre.ApiEnvelope.DataAnnotations.Tests" />
  </ItemGroup>

</Project>
