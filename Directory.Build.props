<Project>

  <PropertyGroup Label="Language">
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Label="Package">
    <!-- VersionPrefix, not Version: the release pipeline supplies VersionSuffix per branch
         (alpha on development, beta on testing, none on production). Setting Version here
         would override both and defeat that. -->
    <VersionPrefix>1.0.0</VersionPrefix>
    <Authors>TheSpectreDev</Authors>
    <Company>TheSpectreDev</Company>
    <Copyright>Copyright (c) TheSpectreDev</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/devahmedh/Api-Envelope</PackageProjectUrl>
    <RepositoryUrl>https://github.com/devahmedh/Api-Envelope</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>aspnetcore;api;response;envelope;wrapper;error-handling;i18n;localization;middleware;autowrapper-alternative</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <!-- Ship the README inside every package so it renders on the NuGet gallery page.
       Only packable projects need it; adding it unconditionally would fail test projects. -->
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <PropertyGroup Label="SourceLink">
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

</Project>
